    actioncase1: "\uC644\uC131! \uC2DD\uC0AC\uB97C \uC990\uACA8\uBCF4\uC138\uC694!"
    actioncase2: "\uC774\uB7F0! \uC81C\uAC00 \uC2E4\uD328\uD560 \uC904\uC774\uC57C..
