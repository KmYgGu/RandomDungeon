    hp80: "\uC774 \uC815\uB3C4 \uC190\uD574\uB294 \uD22C\uC790\uB77C\uACE0 \uC0DD\uAC01\uD558\uC9C0."
    hp60: "\uD750\uC74C\u2026 \uC7A5\uC0AC\uAC00 \uC0DD\uAC01\uBCF4\uB2E4 \uC5B4\uB835\uAD70."
