    meet: "\uC548\uB155 \uB09C \uBAA8\uD5D8\uAC00\uC57C! \uAC19\uC774 \uB3D9\uD589\uD560\uAE4C?"
    hp100: "\uC55E\uC73C\uB85C \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB0A0\uAE4C?"
    hp80: "\uB108\uB791 \uAC19\uC774 \uB2E4\uB2C8\uB2C8\uAE4C \uBBFF\uC74C\uC9C1\uD574!"
    hp60: "\uC774 \uC815\uB3C4\uB294 \uC544\uBB34\uB807\uC9C0\uB3C4 \uC54A\uC544!"
    hp30: "\uB044\uC751, \uC870\uAE08\uC740 \uC26C\uACE0 \uC2F6\uC740\uB370"
    hp10: "\uACE0\uD5A5\uC5D0\uC11C \uB18D\uC0AC\uB098 \uC9C0\uC744 \uAEC4 \uADF8\uB7AC\uB098.."
