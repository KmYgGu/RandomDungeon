    hp1: "\uC774\uB807\uAC8C \uC8FD\uC73C\uBA74\u2026 \uC5B5\uC6B8\uD574\uC11C\uB77C\uB3C4
      \uBABB \uAC00!"
    action: "\uB0B4\uAC00 \uC774 \uBB3C\uAC74\uC758 \uC2DC\uC138\uB97C \uC798 \uC544\uB294
      \uB370, \uC880 \uAE4E\uC544\uC8FC\uC9C0~?"
    actioncase1: "\uC88B\uC558\uC5B4! \uC774\uAC70 \uBC11\uC9C0\uB294 \uC7A5\uC0AC\uB294
