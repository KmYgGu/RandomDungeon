    action: "\uCD9C\uAD6C\uB97C \uCD94\uCE21\uD574 \uBCFC\uAE4C?"
    actioncase1: "\uC74C.. \uC544\uBB34\uB798\uB3C4 \uC5EC\uAE30\uCBE4\uC774 \uC544\uB2D0\uAE4C?"
    actioncase2: "\uBBF8\uC548, \uC804\uD600 \uBAA8\uB974\uACA0\uC5B4."
    actioncase3: "\uC5EC\uAE30\uAC00 \uBD84\uBA85\uD574! \uD655\uC2E4\uD574!"
  - id: 10002
    name: "\uC5EC\uC804\uC0AC"
    meet: "\uBB50\uC57C? \uC57D\uD574 \uBCF4\uC774\uB294 \uB370 \uADF8\uB798\uC11C
      \uC0B4\uC544\uB0A8\uC744 \uC218 \uC788\uACA0\uC5B4? \uAC19\uC774 \uAC00\uC8FC\uC9C0"
    hp100: "\uC774 \uC815\uB3C4 \uC0C1\uCC98\uB85C \uC4F0\uB7EC\uC9C8 \uAC83 \uAC19\uC544?"
    hp80: "\uC544\uC9C1 \uBAB8\uC740 \uCDA9\uBD84\uD788 \uC6C0\uC9C1\uC5EC."
    hp60: "\uC870\uAE08 \uC544\uD504\uAE34 \uD558\uB124. \uD558\uC9C0\uB9CC \uCC38\uC744
      \uB9CC\uD574."
