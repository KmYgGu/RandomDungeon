    actioncase3: "\uAD81\uADF9\uC758 \uB9DB\uC774 \uD0C4\uC0DD\uD588\uC2B5\uB2C8\uB2E4!
      \uC9C0\uAE08 \uB2F9\uC7A5 \uB4DC\uC154\uBCF4\uC2DC\uC8E0!"
  - id: 10005
    name: "\uC0C1\uC778"
