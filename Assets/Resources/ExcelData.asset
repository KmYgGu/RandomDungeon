    hp10: "\uC544\uC9C1\u2026 \uC4F0\uB7EC\uC9C8 \uC218 \uC5C6\uC5B4\u2026!"
    hp1: "\uC77C\uC5B4\uB098\u2026 \uB2E4\uC2DC \uC77C\uC5B4\uB098\uC57C \uD574\u2026"
    action: 
    actioncase1: 
    actioncase2: 
    actioncase3: 
  - id: 10003
    name: "\uB3C4\uC801"
    meet: "\uBAA8\uD5D8\uAC00\uC57C? \uADF8\uB7FC \uB098\uB791 \uD300 \uB9FA\uC744\uB798?
      \uD798\uB4E0\uAC74 \uB108\uAC00~ \uC26C\uC6B4 \uAC74 \uB0B4\uAC00~!"
    hp100: "\uB290\uB824~ \uAD7C\uBCB5\uC774\uAC00 \uB530\uB85C \uC5C6\uC796\uC544~"
    hp80: "\uC544\uC57C! \uB9DE\uC544 \uBC84\uB838\uC796\uC544! \uB611\uBC14\uB85C
      \uD574!"
    hp60: "\uC544\uD504\uB2E4\uACE0! \uC815\uB9D0~ "
    hp30: "\uB0A0 \uC815\uB9D0 \uC8FD\uAC8C \uB0B4\uBE44\uB824 \uB458\uAEBC\uC57C?"
    hp10: "\uC0B4\uB824\uC918! \uC8FD\uACE0 \uC2F6\uC9C0 \uC54A\uC544!"
    hp1: "\uC73C\uC544\uC544\uC559!"
    action: "\uC544\uC774\uD15C\uC744 \uB2EC\uB77C\uACE0?"
    actioncase1: "\uC2EB\uC740\uB370~"
    actioncase2: "\uD310\uB9E4\uAC00\uC758 \uC808\uBC18\uB9CC \uC900\uB2E4\uBA74
      \uB3CC\uB824\uC904\uAED8! \uB098 \uB108\uBB34 \uCC29\uD55C \uAC70 \uC544\uB2C8\uC57C~?"
    actioncase3: "\uD765! \uC774\uBC88 \uD55C\uBC88\uB9CC\uC774\uC57C!"
  - id: 10004
    name: "\uC694\uB9AC\uC0AC"
    meet: "\uC804 \uC138\uACC4\uC758 \uBBF8\uC2DD\uC744 \uC704\uD574 \uAC01\uC9C0\uB97C
      \uB5A0\uB3CC\uACE0 \uC788\uB2F5\uB2C8\uB2E4~ \uADF8 \uC5EC\uC815\uC744 \uAC19\uC774
      \uAC00\uC2DC\uACA0\uB098\uC694?"
    hp100: "\uC5B4\uB5A4 \uC74C\uC2DD\uC774 \uC808 \uAE30\uB2E4\uB9B4\uAE4C\uC694?"
    hp80: "\uD638\uD638\uD638! \uC5EC\uC720\uB86D\uC2B5\uB2C8\uB2E4!"
    hp60: "\uC8FC\uBC29\uC758 \uC5F4\uAE30\uC5D0 \uBE44\uD558\uBA74 \uBCC4 \uAC70
