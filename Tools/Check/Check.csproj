<Project Sdk="Microsoft.NET.Sdk">

  <!--
    게임 소스 전체를 Unity 없이 컴파일해 보기 위한 프로젝트.

    실제 게임을 빌드하는 것이 아니라, Assets/Code 와 Assets/RCode 의 .cs 를
    그대로 긁어다 컴파일만 해 본다. 에디터를 켜지 않고도 문법 오류와 형 오류를
    잡을 수 있고, Verify 가 이 결과물(Check.dll)을 불러 실제 알고리즘을 돌려 본다.

    CS0169/0414/0649(쓰이지 않는 필드)는 Inspector 로 값을 넣는 Unity 필드에서
    정상적으로 나오는 것이라 꺼 둔다.
  -->
  <Import Project="../Common.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Check</AssemblyName>
    <NoWarn>CS0169;CS0414;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ProjectRoot)Assets/Code/**/*.cs" />
    <Compile Include="$(ProjectRoot)Assets/RCode/**/*.cs" />
    <!-- 엑셀 임포터의 런타임 조각(ExcelAssetAttribute). Editor 폴더는 뺀다 -->
    <Compile Include="$(ProjectRoot)Assets/ExcelImporter/Runtime/**/*.cs" />
    <!--
      2d-extras 의 RuleTile. 게임 코드가 이것을 물려받는다(SiblingRuleTile).
      Unity 에서는 asmdef 로 나뉜 별도 어셈블리지만, 여기서는 함께 컴파일해야
      물려받은 쪽의 오류를 잡을 수 있다. Samples~ 는 Unity 가 무시하는 폴더라 뺀다.
    -->
    <Compile Include="$(ProjectRoot)Assets/BasicTile/2d-extras-2020.3/Runtime/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.AIModule"><HintPath>$(UnityManaged)/UnityEngine.AIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ARModule"><HintPath>$(UnityManaged)/UnityEngine.ARModule.dll</HintPath></Reference>
